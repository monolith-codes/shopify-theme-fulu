<div class="fulu-home-grid">
    <div class="fulu-home-grid-spacer"></div>
    <div class="fulu-home-grid-container">
        <div class="fulu-home-grid-content">
            <a href="{{ routes.collections_url }}/yoshy-project" class="fulu-home-grid-item i-1">
                <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/yoshy_project_banner2.webp?v=1772680074" alt="YOSHY PROJECT" fetchpriority="high" width="1200" height="800"/>
                <div class="fulu-designer-info">YOSHY PROJECT</div>
            </a>
            <a href="pages/about" class="fulu-home-grid-item i-2">
                <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/about_us.webp?v=1772679260" alt="About Us" fetchpriority="high" width="800" height="1200"/>
                <div class="fulu-designer-info">About us</div>
            </a>
            <a href="/pages/apply" class="fulu-home-grid-item i-3">
                <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/apply_thumb_3ccf17d3-e36e-4d3d-8f15-94b69a7f5756.webp?v=1772675735" alt="Apply" width="1200" height="800"/>
                <div class="fulu-designer-info">Apply</div>
            </a>
        </div>
        {% section 'footer' %}
    </div>
</div>

<style>
    .fulu-home-grid {
        display: grid;
        width: 100svw;
        z-index: 3;
        grid-template-columns: 1fr 6.2fr;
        margin: 0;
        padding: 0;
        position: relative;
    }

    .fulu-home-grid-spacer {
        opacity: 0;
    }

    .fulu-home-grid-container {
        height: 100%;
        min-height: 100%;
        display: flex;
        flex-direction: column;
    }

    .fulu-home-grid-content {
        margin: 35px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
        grid-auto-rows: 7.8svw;
        align-content: start;
        grid-auto-flow: dense;
        gap: 30px;
                z-index: 1;

    }

    .fulu-home-grid-item {
        cursor: pointer;
        border-radius: 15px;
        overflow: hidden;
        position: relative;
    }

    .fulu-home-grid-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .fulu-home-grid-item::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: grey;
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: 1;

    }

    .fulu-home-grid-item:hover::after {
        opacity: 0.15;
    }

    .fulu-designer-info {
        position: absolute;
        bottom: 20px;
        left: 20px;
        opacity: 0;
        transition: opacity 0.3s ease;
        color: #fff;
        font-size: 1.5rem;
        font-weight: bold;
        text-align: left;
        width: auto;
        z-index: 4;
    }

    .fulu-designer-info {
        z-index: 1;
    }

    .fulu-home-grid-item:hover .fulu-designer-info {
        opacity: 1;
    }

    .fulu-home-grid-item.i-1 {
        grid-column: 1 / 6;
        grid-row: 1 / 5;
    }

    .fulu-home-grid-item.i-2 {
        grid-column: 1 / 3;
        grid-row: 5 / 9;
    }

   .fulu-home-grid-item.i-3 {
        grid-column: 3 / 6;
        grid-row: 5 / 9;
    }

   

    @media screen and (max-width: 768px) and (orientation: portrait) {
        .fulu-home-grid-container {
        }

        .fulu-home-grid {
            grid-template-columns: 1fr;
        }

        .fulu-home-grid-spacer {
            display: none;
        }

        .fulu-home-grid-content {
            grid-template-columns: 1fr;
            grid-auto-rows: auto;
            margin: 30px;
        }
        .fulu-home-grid-item {
            grid-column: auto !important;
            grid-row: auto !important;
            aspect-ratio: 3 / 4;
        }
        .fulu-designer-info {
            opacity: 1;
        }

        .fulu-home-grid-content {
            margin-top: 54svw;
        }

         .fulu-home-footer-container {
            height: 50svh;
         }
    }

    @media screen and (max-width: 500px) and (orientation: portrait) {
        .fulu-home-grid-content {
            margin-top: 15.75rem;
        }

        .fulu-home-grid-container {
        }

    }

    @media screen and (max-width: 350px) and (orientation: portrait){
        .fulu-home-grid-content {
            margin-top: 12.75rem;
        }
    }
</style>