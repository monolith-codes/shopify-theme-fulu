{% if product.available %}
  {% if product.has_only_default_variant %}
    <button class="fulu-quick-add-btn" data-variant-id="{{ product.first_available_variant.id }}" aria-label="Quick add to cart">
      <span class="fulu-quick-add-icons">
        <svg class="lucide lucide-shopping-cart" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
        <svg class="lucide lucide-plus fulu-quick-add-plus" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="16" width="16" xmlns="http://www.w3.org/2000/svg"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      </span>
    </button>
  {% else %}
    <button class="fulu-quick-add-btn fulu-quick-add-btn-options" aria-label="Choose options">
      <span class="fulu-quick-add-icons">
        <svg class="lucide lucide-shopping-cart" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
        <svg class="lucide lucide-plus fulu-quick-add-plus" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="16" width="16" xmlns="http://www.w3.org/2000/svg"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      </span>
    </button>
    <div class="fulu-quick-add-options-menu">
      <div class="fulu-quick-add-options-header">
        <span>Options</span>
        <button class="fulu-quick-add-close" aria-label="Close options">×</button>
      </div>
      <div class="fulu-quick-add-variants">
        {% for variant in product.variants %}
          {% if variant.available %}
            <button
              class="fulu-quick-add-variant-btn"
              data-variant-id="{{ variant.id }}"
              data-inventory-quantity="{{ variant.inventory_quantity }}"
              data-inventory-management="{{ variant.inventory_management }}"
              data-inventory-policy="{{ variant.inventory_policy }}"
            >
              {{ variant.title }}
            </button>
          {% else %}
            <button class="fulu-quick-add-variant-btn sold-out" disabled>
              {{ variant.title }} - Sold Out
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
{% endif %}