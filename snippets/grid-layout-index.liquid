<style>
    .fulu-home-grid {
        display: grid;
        min-height: 100%;
        width: 100svw;
        grid-template-columns: 1fr 6.2fr;
        margin: 0;
        padding: 0;        
    }

    .fulu-home-grid-spacer {
        opacity: 0;
        background-color: orange;
    }

    .fulu-home-grid-container {
        height: 100%;
        min-height: 100%;

        display: flex;
        flex-direction: column;
    }

    .fulu-home-grid-content {
        margin: 35px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
        grid-auto-rows: 7.8svw;
        align-content: start;
        grid-auto-flow: dense;
        gap: 30px;
    }

    .fulu-home-grid-item {
        cursor: pointer;
        background-color: blue;
        border-radius: 15px;
        overflow: hidden;
        position: relative;
    }

    .fulu-home-grid-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .fulu-home-grid-item::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: grey;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
        z-index: 1;
    }

    .fulu-home-grid-item:hover::after {
        opacity: 0.15;
    }

    .fulu-designer-info {
        position: absolute;
        bottom: 20px;
        left: 20px;
        opacity: 0;
        transition: opacity 0.3s ease;
        color: #fff;
        font-size: 1.5rem;
        font-weight: bold;
        text-align: left;
        width: auto;
        pointer-events: none;
        z-index: 2;
    }

    .fulu-home-grid-item:hover .fulu-designer-info {
        opacity: 1;
    }

    .fulu-home-grid-item.i-1 {
        grid-column: 1 / 3;
        grid-row: 1 / 4;
    }

    .fulu-home-grid-item.i-2 {
        grid-column: 3 / 6;
        grid-row: 1 / 6;
    }

   .fulu-home-grid-item.i-3 {
        grid-column: 1 / 3;
        grid-row: 4 / 9;
    }

    .fulu-home-grid-item.i-4 {
        grid-column: 3 / 6;
        grid-row: 6 / 10;
    }

    .fulu-home-grid-item.i-5 {
        grid-column: 1 / 3;
        grid-row: 9 / 13;
    }

    .fulu-home-grid-item.i-6 {
        grid-column: 3 / 6;
        grid-row: 10 / 14;
    }

    .fulu-home-grid-item.i-7 {
        grid-column: 1 / 3;
        grid-row: 13 / 18;
    }

    .fulu-home-grid-item.i-8 {
        background-color: purple !important;
        grid-column: 3 / 6;
        grid-row: 14 / 18;
    }

    @media screen and (max-width: 768px), screen and (orientation: portrait) {
        .fulu-home-grid-container {
            margin-bottom: 20svw;
        }

        .fulu-home-grid {
            grid-template-columns: 1fr;
        }

        .fulu-home-grid-spacer {
            display: none;
        }

        .fulu-home-grid-content {
            grid-template-columns: 1fr;
            grid-auto-rows: auto;
            margin: 30px;
        }
        .fulu-home-grid-item {
            grid-column: auto !important;
            grid-row: auto !important;
            aspect-ratio: 3 / 4;
        }
        .fulu-designer-info {
            opacity: 1;
        }

        .fulu-home-grid-content {
            margin-top: 54svw;
            margin-bottom: 20svw;
        }

         .fulu-home-footer-container {
            height: 50svh;
         }
    }

    @media screen and (max-width: 500px) and (orientation: portrait) {
        .fulu-home-grid-content {
            margin-top: 14.4rem;
            margin-bottom: 100px;
        }

        .fulu-home-grid-container {
            margin-bottom: 150px;
        }

    }

</style>

<div class="fulu-home-grid">
        <div class="fulu-home-grid-spacer"></div>
        <div class="fulu-home-grid-container">
            <div class="fulu-home-grid-content">
                <div class="fulu-home-grid-item i-1">
                    <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/fs13.webp?v=1772084153" alt="Designer 1" fetchpriority="high" />
                    <div class="fulu-designer-info">Designer 1</div>
                </div>
                <div class="fulu-home-grid-item i-2">
                    <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/fs5.webp?v=1771883612" alt="Designer 2" fetchpriority="high" />
                    <div class="fulu-designer-info">Designer 2</div>
                </div>
                <div class="fulu-home-grid-item i-3">
                    <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/fs6.webp?v=1771884770" alt="Designer 3" loading="lazy" />
                    <div class="fulu-designer-info">Designer 3</div>
                </div>
                <div class="fulu-home-grid-item i-4">
                    <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/fs11.webp?v=1772067801" alt="Designer 4" loading="lazy" />
                    <div class="fulu-designer-info">Designer 4</div>
                </div>
                <div class="fulu-home-grid-item i-5">
                    <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/fs2.webp?v=1771880941" alt="Designer 5" loading="lazy" />
                    <div class="fulu-designer-info">Designer 5</div>
                </div>
                <div class="fulu-home-grid-item i-6">
                    <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/fs7.webp?v=1772059811" alt="Designer 6" loading="lazy" />
                    <div class="fulu-designer-info">Designer 6</div>
                </div>
                <div class="fulu-home-grid-item i-7">
                    <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/fs10.webp?v=1772061271" alt="Designer 7" loading="lazy" />
                    <div class="fulu-designer-info">Designer 7</div>
                </div>
                <div class="fulu-home-grid-item i-8">
                    <img src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/fs12.webp?v=1772071801" alt="About Us" loading="lazy" />
                    <div class="fulu-designer-info">About Us</div>
                </div>
            </div>
            {% section 'footer' %}
        </div>
    </div>
</div>