<div class="fulu-logo-animation-container">
    <div class="fulu-logo-animation-ceil">
        <div class="fulu-logo-animation-cell" id="fulu-animation-cell-1">
            <div class="fulu-logo-animation-letter" id="fulu-animation-letter-1"><a class="fulu-animation-letter-link" href="{{ routes.root_url }}">SZ</a></div>
        </div>
        <div class="fulu-logo-animation-cell" id="fulu-animation-cell-2">
            <div class="fulu-logo-animation-letter" id="fulu-animation-letter-2">E</div>
        </div>
    </div>

    <div class="fulu-logo-animation-row">
        <div class="fulu-logo-animation-cell" id="fulu-animation-cell-3">
            <div class="fulu-logo-animation-letter" id="fulu-animation-letter-3">NE</div>
        </div>
    </div>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        const scrollContainer = document.querySelector('.scroll-container');
        const cell1 = document.getElementById('fulu-animation-cell-1');
        const cell2 = document.getElementById('fulu-animation-cell-2');
        const cell3 = document.getElementById('fulu-animation-cell-3');

        // Bail out early if any required element is missing
        if (!scrollContainer || !cell1 || !cell2 || !cell3) return;

        let ticking = false;
        let maxScroll = 0;
        let isWindowScroll = false;
        let startY = 0;
        let startX = 0;
        let endY = 0;
        let distanceX = 0;
        let offsetX = 0;
        let resizeTimer;

        function calculateDimensions() {
            // Reset transforms to ensure clean measurements
            cell1.style.transform = '';
            cell3.style.transform = '';

            maxScroll = scrollContainer.scrollHeight - scrollContainer.clientHeight;
            
            if (maxScroll <= 0) {
                maxScroll = document.documentElement.scrollHeight - window.innerHeight;
                isWindowScroll = true;
            } else {
                isWindowScroll = false;
            }
            
            maxScroll = Math.max(0, maxScroll);
            
            const rect1 = cell1.getBoundingClientRect();
            const rect2 = cell2.getBoundingClientRect();
            const rect3 = cell3.getBoundingClientRect();

            // Calculate offsets
            offsetX = (cell1.offsetWidth - cell1.offsetHeight) / 2;

            startY = offsetX;
            startX = 0;

            // Calculate target position (touching cell2) accounting for 90deg rotation
            endY = cell2.offsetTop - cell1.offsetTop - (cell1.offsetWidth + cell1.offsetHeight) / 2;
            
            distanceX = rect3.left - rect2.right;
        }

        function updatePosition() {
            const scrollTop = isWindowScroll ? (window.scrollY || document.documentElement.scrollTop) : scrollContainer.scrollTop;
            
            // Calculate and clamp fraction between 0 and 1 cleanly
            const scrollFraction = maxScroll > 0 
                ? Math.min(Math.max(scrollTop / maxScroll, 0), 1) 
                : 1;

            const currentY = startY + (endY - startY) * scrollFraction;
            const currentX = startX - (distanceX * scrollFraction);

            cell1.style.transform = `translateY(${currentY}px) translateX(${-offsetX}px) rotate(90deg)`;
            cell3.style.transform = `translateX(${currentX}px)`;
        }

        const onScroll = () => {
            if (!ticking) {
                window.requestAnimationFrame(() => {
                    updatePosition();
                    ticking = false;
                });
                ticking = true;
            }
        };

        scrollContainer.addEventListener('scroll', onScroll);
        window.addEventListener('scroll', onScroll);
        
        window.addEventListener('resize', () => { // Debounce resize event
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                calculateDimensions();
                updatePosition();
            }, 150);
        });

        window.addEventListener('load', () => {
            calculateDimensions();
            updatePosition();
        });

        // Initialize dimensions and trigger first render
        calculateDimensions();
        updatePosition();
    });
</script>

<style>
    .fulu-logo-animation-container {
        display: flex;
        height: 100svh;
        width: 100%;
        position: fixed;
        z-index: 100;
        pointer-events: none;
    }
    
    .fulu-logo-animation-ceil {
        width: 15svw;
        height: 100%;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        pointer-events: none;
        margin-left: 30px;
    }

    .fulu-logo-animation-row {
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
        flex-grow: 1;
        height: 15svw;
        z-index: 1000 !important;
        align-self: end;
        pointer-events: none;
    }

    .fulu-logo-animation-cell {
        z-index: 4000 !important;
        pointer-events: none;
        display: inline-flex; 
        width: fit-content;
        height: fit-content;
    }

    .fulu-logo-animation-letter {
        font-size: 13svw;
        font-family: "tachyon", sans-serif;
        font-weight: 400;
        font-style: normal;
        display: inline-block;
        color: #3d1b31;
    }

    #fulu-animation-cell-1 {
        transform: rotate(90deg);
        margin-top: 35px;
        will-change: transform;    
    }
    
    .fulu-animation-letter-link {
        color: black;
        color: #3d1b31;
    }

    #fulu-animation-letter-1 {
        text-align: center;
        line-height: 10svw;
        cursor: pointer;
        pointer-events: auto;
        overflow: hidden;
        color: black !important;
    }


    #fulu-animation-letter-2, #fulu-animation-letter-3 {
        line-height: .63;
        margin-bottom: 0;
        text-align: center;
    }

    #fulu-animation-cell-3 {
        margin-right: 20px;
        will-change: transform;
    }

    #fulu-animation-cell-2, #fulu-animation-cell-3 {
        margin-bottom: 55px;
    }

    @media screen and (max-width: 768px) and (orientation: portrait) {
        .fulu-logo-animation-ceil {
            width: 25svw;
            align-items: flex-start;
            margin-left: 35px;
        }

        .fulu-logo-animation-letter {
            font-size: 12.5svw;
            font-family: "tachyon", sans-serif;
            font-weight: 400;
        }

        #fulu-animation-cell-1 {
            margin-top: 35px;
        }

        #fulu-animation-letter-1 {
            line-height: .79;
        }
    }

    @media screen and (max-width: 500px) and (orientation: portrait) {


        #fulu-animation-cell-1 {
            transform: rotate(90deg);
            margin-top: 30px;
        }

        .fulu-logo-animation-letter {
            font-size: 5rem;
        }

        #fulu-animation-cell-3 {
            margin-right: 25px;
        }

        #fulu-animation-letter-2, #fulu-animation-letter-3 {
            line-height: .7;
        }
    }

    @media screen and (max-height: 500px) {
        .fulu-logo-animation-letter { 
            line-height: .75 !important;
        }

        .fulu-logo-animation-letter {
            font-size: 10svh;
        }
    }

    @media screen and (max-width: 500px) and (orientation: portrait){
        .fulu-logo-animation-letter { 
            line-height: .75 !important;
        }

        .fulu-logo-animation-letter {
            font-size: 17.5svw;
        }
    }


    @media screen and (max-width: 350px) and (orientation: portrait){
        .fulu-logo-animation-letter { 
            line-height: .75 !important;
        }

        .fulu-logo-animation-letter {
            font-size: 20.5svw;
        }
    }
</style>