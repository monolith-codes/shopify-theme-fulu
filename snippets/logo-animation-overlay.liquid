<style>
    .fulu-logo-animation-container {
        display: flex;
        height: 100svh;
        width: 100%;
        overflow-y: auto;
        position: absolute;
        z-index: 1;
        pointer-events: none;
        z-index: 4000;
    }
    
    .fulu-logo-animation-ceil {
        width: 15svw;
        height: 100%;
        z-index: 1000 !important;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        pointer-events: none;
        margin-left: 30px;
    }

    .fulu-logo-animation-row {
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
        flex-grow: 1;
        height: 15svw;
        z-index: 1000 !important;
        align-self: end;
        pointer-events: none;
    }

    .fulu-logo-animation-cell {
        z-index: 4000 !important;
        pointer-events: none;
        display: inline-flex; 
        width: fit-content;
        height: fit-content;
    }

    .fulu-logo-animation-letter {
        font-size: 13svw;
        font-family: "tachyon", sans-serif;
        font-weight: 400;
        font-style: normal;
        display: inline-block;
    }

    #fulu-animation-cell-1 {
        transform: rotate(90deg);
        margin-top: 35px;
        will-change: transform;    
    }

    #fulu-animation-letter-1 {
        text-align: center;
        line-height: 10svw;
    }

    #fulu-animation-letter-2, #fulu-animation-letter-3 {
        line-height: .63;
        margin-bottom: 0;
        text-align: center;
    }

    #fulu-animation-cell-3 {
        margin-right: 20px;
    }

    #fulu-animation-cell-2, #fulu-animation-cell-3 {
        margin-bottom: 55px;
    }



    @media screen and (max-width: 768px), screen and (orientation: portrait) {
        .fulu-logo-animation-ceil {
            width: 21svw;
            align-items: flex-start;
            margin-left: 35px;
        }

        .fulu-logo-animation-letter {
            font-size: 20svw;
            font-family: "tachyon", sans-serif;
            font-weight: 400;
        }

        #fulu-animation-cell-1 {
            margin-top: 35px;
        }

        #fulu-animation-letter-1 {
            line-height: 0.79;
        }




    }

    @media screen and (max-width: 500px) and (orientation: portrait) {


        #fulu-animation-cell-1 {
            transform: rotate(90deg);
            margin-top: 30px;
        }

        .fulu-logo-animation-letter {
            font-size: 5rem;
        }

        #fulu-animation-cell-3 {
            margin-right: 25px;
        }

        #fulu-animation-letter-2, #fulu-animation-letter-3 {
            line-height: .7;
        }
    }

    @media screen and (max-height: 500px) {
        .fulu-logo-animation-letter { 
            line-height: .75 !important;
        }

        .fulu-logo-animation-letter {
            font-size: 10svh;
        }
    }
</style>

<div class="fulu-logo-animation-container">
    <div class="fulu-logo-animation-ceil">
        <div class="fulu-logo-animation-cell" id="fulu-animation-cell-1">
            <div class="fulu-logo-animation-letter" id="fulu-animation-letter-1">SZ</div>
        </div>
        <div class="fulu-logo-animation-cell" id="fulu-animation-cell-2">
            <div class="fulu-logo-animation-letter" id="fulu-animation-letter-2">E</div>
        </div>
    </div>

    <div class="fulu-logo-animation-row">
        <div class="fulu-logo-animation-cell" id="fulu-animation-cell-3">
            <div class="fulu-logo-animation-letter" id="fulu-animation-letter-3">NE</div>
        </div>
    </div>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        const scrollContainer = document.querySelector('.fulu-content-container');
        const cell1 = document.getElementById('fulu-animation-cell-1');
        const cell2 = document.getElementById('fulu-animation-cell-2');
        const cell3 = document.getElementById('fulu-animation-cell-3');

        // Bail out early if any required element is missing
        if (!scrollContainer || !cell1 || !cell2 || !cell3) return;

        let ticking = false;
        let maxScroll = 0;
        let startY = 0;
        let startX = 0;
        let endY = 0;
        let distanceX = 0;
        let offsetX = 0;

        function calculateDimensions() {
            // Reset transforms to ensure clean measurements
            cell1.style.transform = '';
            cell3.style.transform = '';

            maxScroll = Math.max(0, scrollContainer.scrollHeight - scrollContainer.clientHeight);
            
            const rect1 = cell1.getBoundingClientRect();
            const rect2 = cell2.getBoundingClientRect();
            const rect3 = cell3.getBoundingClientRect();

            // Calculate offsets
            offsetX = (cell1.offsetWidth - cell1.offsetHeight) / 2;

            startY = offsetX;
            startX = 0;

            // Calculate target position (touching cell2) accounting for 90deg rotation
            endY = cell2.offsetTop - cell1.offsetTop - (cell1.offsetWidth + cell1.offsetHeight) / 2;
            
            distanceX = rect3.left - rect2.right;
        }

        function updatePosition() {
            const scrollTop = scrollContainer.scrollTop;
            
            // Calculate and clamp fraction between 0 and 1 cleanly
            const scrollFraction = maxScroll > 0 
                ? Math.min(Math.max(scrollTop / maxScroll, 0), 1) 
                : 0;

            const currentY = startY + (endY - startY) * scrollFraction;
            const currentX = startX - (distanceX * scrollFraction);

            cell1.style.transform = `translateY(${currentY}px) translateX(${-offsetX}px) rotate(90deg)`;
            cell3.style.transform = `translateX(${currentX}px)`;
        }

        scrollContainer.addEventListener('scroll', () => {
            if (!ticking) {
                window.requestAnimationFrame(() => {
                    updatePosition();
                    ticking = false;
                });
                ticking = true;
            }
        });
        
        window.addEventListener('resize', () => {
            calculateDimensions();
            updatePosition();
        });

        window.addEventListener('load', () => {
            calculateDimensions();
            updatePosition();
        });

        // Initialize dimensions and trigger first render
        calculateDimensions();
        updatePosition();
    });
</script>