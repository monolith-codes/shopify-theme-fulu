<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <link rel="canonical" href="{{ canonical_url }}">
        <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
        <link rel="stylesheet" href="https://use.typekit.net/fod3net.css">

        {%- if settings.favicon != blank -%}
            <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
        {%- endif -%}

        <title>
            {{ page_title }}
            {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
            {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
            {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
        </title>

        {% if page_description %}
            <meta name="description" content="{{ page_description | escape }}">
        {% endif %}

        
        {{content_for_header}}
    </head>

    <body>
        <div class="scroll-container">
            {% unless template == 'password' %}
                {% render 'main-menu' %}
            {% endunless %}
        
            <div id="fulu-page-loader">
                <div class="fulu-spinner"></div>
            </div>
            <main id="fulu-main-content" role="main">
                {{ content_for_layout }}            
            </main>
        </div>
        {% render 'cart-menu' %}

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Global Quick Add to Cart Logic
                document.body.addEventListener('click', function(e) {
                    const btn = e.target.closest('.fulu-quick-add-btn');
                    if (!btn) return;
                    
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const variantId = btn.getAttribute('data-variant-id');
                    if (!variantId) return;

                    const originalHTML = btn.innerHTML;
                    btn.innerHTML = '<div class="fulu-spinner" style="width: 20px; height: 20px; border-width: 2px;"></div>';
                    btn.disabled = true;

                    const formData = new FormData();
                    formData.append('id', variantId);
                    formData.append('quantity', 1);

                    const addUrl = window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js';

                    fetch(addUrl, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        },
                        body: formData
                    })
                    .then(response => {
                        if (!response.ok) {
                            return response.json().then(errorData => {
                                throw new Error(errorData.description || errorData.message || 'Error adding to cart');
                            });
                        }
                        return response.json();
                    })
                    .then(cart => {
                        btn.innerHTML = originalHTML;
                        btn.disabled = false;
                        
                        if (typeof window.fuluOpenCart === 'function') {
                            window.fuluOpenCart();
                        } else {
                            document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
                            document.dispatchEvent(new CustomEvent('cart:open'));
                        }
                    })
                    .catch(err => {
                        console.error('Quick Add Error:', err);
                        btn.innerHTML = originalHTML;
                        btn.disabled = false;
                        
                        if (typeof window.fuluOpenCart === 'function') {
                            window.fuluOpenCart();
                        } else {
                            document.dispatchEvent(new CustomEvent('cart:open'));
                        }
                    });
                });
            });
        </script>
        <style>
            /* Global Quick Add Button Styles */
            .fulu-product-item-wrapper {
                position: relative;
                display: block;
                border-radius: 15px;
                overflow: hidden;
            }

            .fulu-quick-add-btn {
                position: absolute;
                bottom: 20px;
                right: 20px;
                background: #fff;
                color: #000;
                border: none;
                border-radius: 20px;
                width: 40px;
                height: 40px;
                display: flex;
                justify-content: center;
                align-items: center;
                cursor: pointer;
                opacity: 0;
                visibility: hidden;
                transform: translateY(10px);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                z-index: 5;
                box-shadow: 0 4px 10px rgba(0,0,0,0.15);
                overflow: hidden;
            }

            .fulu-quick-add-icons {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
            }

            .fulu-quick-add-plus {
                opacity: 0;
                width: 0;
                transform: translateX(-10px);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .fulu-quick-add-btn:hover {
                background: #000;
                color: #fff;
                width: 70px;
            }

            .fulu-quick-add-btn:hover .fulu-quick-add-plus {
                opacity: 1;
                width: 16px;
                transform: translateX(0);
            }

            .fulu-product-item-wrapper:hover .fulu-quick-add-btn {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            @media screen and (max-width: 768px) {
                .fulu-quick-add-btn {
                    display: none !important;
                }
            }
        </style>
    </body>
</html>

<style>
    @font-face {
        font-family: "Inter";
        src: url('https://cdn.shopify.com/s/files/1/1043/1584/6995/files/Inter.ttf?v=1771807709') format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: "Unbounded";
        src: url('https://cdn.shopify.com/s/files/1/1043/1584/6995/files/Unbounded.ttf?v=1771809449') format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }

    html {
        overflow-x: hidden;
        -webkit-text-size-adjust: 100%;
    }

    html, body{
        overflow: hidden;
        height: 100%;
        position: fixed;
        width: 100%;
    }

    body {
        min-height: 700px;
        margin: 0;
        padding: 0;
        background-color: #f9f9f9; /* Soft off-white to match the minimalist vibe */
        font-family: "Inter";
        color: #000;
        width: 100%;
    }

    .scroll-container {
        height: 100vh; /* Use vh here; it won't resize because body isn't scrolling */
        overflow-y: auto;
        -webkit-overflow-scrolling: touch; /* Smooth scrolling for older iOS */
    }

    #fulu-page-loader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #f9f9f9;
        z-index: 999999;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: opacity 0.5s ease-out;
    }

    .fulu-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(0, 0, 0, 0.1);
        border-radius: 50%;
        border-top-color: #000;
        animation: fulu-spin 0.8s ease-in-out infinite;
    }

    @keyframes fulu-spin {
        to { transform: rotate(360deg); }
    }

    #fulu-main-content {
        opacity: 0;
        transition: opacity 0.8s ease-out;
    }

    .visually-hidden {
        position: absolute !important;
        overflow: hidden;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        border: 0;
        clip: rect(0 0 0 0);
        word-wrap: normal !important;
    }

    #shopify-pc__banner__btn-accept {
        background-color: black !important;
        color: white;
    }
</style>

<script>
    const loadPromise = new Promise(resolve => {
        if (document.readyState === 'complete') {
            resolve();
        } else {
            window.addEventListener('load', resolve);
        }
    });

    const fontPromise = document.fonts ? document.fonts.ready : Promise.resolve();

    Promise.all([loadPromise, fontPromise]).then(() => {
        const loader = document.getElementById('fulu-page-loader');
        const content = document.getElementById('fulu-main-content');
        
        if (loader && content) {
            loader.style.opacity = '0';
            content.style.opacity = '1';
            
            setTimeout(() => {
                loader.style.display = 'none';
            }, 500);
        }
    });
</script>