{% render 'logo-animation-overlay' %}


<div class="fulu-content-container">
    <div class="fulu-page-apply-container">
        <div class="fulu-apply-spacer"></div>
        <div class="fulu-apply-content">
            <div class="fulu-apply-container">
                <div class="fulu-apply">
                    <h1 class="fulu-apply-title">Apply</h1>
                    <p class="fulu-apply-text">Interested in joining the club? Fill out the form below.</p>

                    {% form 'contact' %}
                        {% if form.posted_successfully? %}
                            <div class="fulu-success-container">
                                <svg class="fulu-checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                                    <circle class="fulu-checkmark__circle" cx="26" cy="26" r="25" fill="none"/>
                                    <path class="fulu-checkmark__check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
                                </svg>
                                <p class="fulu-success-text">Thanks for applying! We'll be in touch shortly.</p>
                            </div>
                        {% else %}
                            {{ form.errors | default_errors }}
    
                        <div class="fulu-form-row">
                            <div class="fulu-form-group">
                                <label for="ContactFormName" class="fulu-required-label">Name</label>
                                <input type="text" id="ContactFormName" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
                            </div>
                            <div class="fulu-form-group">
                                <label for="ContactFormEmail" class="fulu-required-label">Email</label>
                                <input type="email" id="ContactFormEmail" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
                            </div>
                        </div>

                        <div class="fulu-form-group">
                            <label for="ContactFormPhone" class="fulu-required-label">Phone Number</label>
                            <input type="tel" id="ContactFormPhone" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" required>
                        </div>

                        <div class="fulu-form-group">
                            <label for="ContactFormType">I am a...</label>
                            <select id="ContactFormType" name="contact[type]">
                                <option value="Designer">Designer</option>
                                <option value="Artist">Artist</option>
                                <option value="Collector">Collector</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="fulu-form-group">
                            <label for="ContactFormPortfolio">Portfolio / Website</label>
                            <input type="url" id="ContactFormPortfolio" name="contact[portfolio]" placeholder="https://">
                        </div>

                        <div class="fulu-form-group">
                            <label for="ContactFormMessage" class="fulu-required-label">Tell us about yourself</label>
                            <textarea rows="5" id="ContactFormMessage" name="contact[body]" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
                        </div>

                        <button type="submit" class="fulu-submit-btn">Submit Application</button>
                        {% endif %}
                    {% endform %}
                </div>
            </div>
            {% section 'footer' %}
        </div>
    </div>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        const formElement = document.querySelector('.fulu-apply form');
        const successContainer = document.querySelector('.fulu-success-container');

        if (formElement) {
            if (!successContainer) {
                const updateHeight = () => {
                    sessionStorage.setItem('fulu_contact_form_height', formElement.offsetHeight);
                };
                updateHeight();
                window.addEventListener('resize', updateHeight);

                formElement.addEventListener('submit', function() {
                    sessionStorage.setItem('fulu_apply_scroll_pos', window.scrollY);
                });
            } else {
                const savedHeight = sessionStorage.getItem('fulu_contact_form_height');
                if (savedHeight) {
                    successContainer.style.minHeight = `${savedHeight}px`;
                }

                const savedScroll = sessionStorage.getItem('fulu_apply_scroll_pos');
                if (savedScroll) {
                    setTimeout(() => {
                        window.scrollTo(0, parseFloat(savedScroll));
                        sessionStorage.removeItem('fulu_apply_scroll_pos');
                    }, 10);
                }
            }
        }
    });
</script>

<style>
    .fulu-content-container {
        height: 100%;
        width: 100%;
        z-index: 3;
        pointer-events: all !important;
        background-color: white;
    }
    

    .fulu-page-apply-container {
        display: grid;
        width: 100%;
        height: 100%;
        grid-template-columns: 1fr 6.2fr;
        z-index: 200;
    }

    .fulu-apply-spacer {
        height: 100%;
    }

    .fulu-apply-container {
        display: flex;
        justify-content: center;
        margin-top: 35px;
        margin-bottom: 0;
        width: calc(100% - 13.8%);
        font-family: "Inter";
    }

    .fulu-apply {
        width: 65%;
        position: relative;
        right: 2%;
        z-index: 2;
    }

    .fulu-apply-title {
        font-size: 2.5rem;
        margin-bottom: 10px;
        text-align: start;
        font-weight: 600;
    }

    .fulu-apply-text {
        text-align: start;
        margin-bottom: 60px;
        color: #333;
    }

    .fulu-form-row {
        display: flex;
        gap: 20px;
    }

    .fulu-form-row .fulu-form-group {
        flex: 1;
    }

    .fulu-form-group {
        margin-bottom: 25px;
    }

    .fulu-form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .fulu-required-label::after {
        content: "*";
        margin-left: 4px;
    }

    .fulu-form-group input,
    .fulu-form-group select,
    .fulu-form-group textarea {
        width: 100%;
        padding: 12px 0;
        border: none;
        border-bottom: 1px solid #000;
        background: transparent;
        font-family: "Inter", sans-serif;
        font-size: 1rem;
        outline: none;
        border-radius: 0;
        transition: border-color 0.3s;
    }

    .fulu-form-group input:focus,
    .fulu-form-group select:focus,
    .fulu-form-group textarea:focus {
        border-bottom-color: #666;
    }

    .fulu-submit-btn {
        width: 32.5%;
        padding: 16px;
        background-color: #000;
        color: #fff;
        border: 1px solid #000;
        font-family: "Inter", sans-serif;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 20px;
        margin-bottom: 5svh;
        border-radius: 20px;
    }

    .fulu-submit-btn:hover {
        background-color: transparent;
        color: #000;
    }

    .form-success {
        background-color: #f4f4f4;
        padding: 15px;
        margin-bottom: 20px;
        text-align: center;
    }

    .fulu-success-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 0;
        animation: fuluFadeIn 0.8s ease-out;
        box-sizing: border-box;
    }

    .fulu-success-text {
        font-size: 1.2rem;
        margin-top: 20px;
        text-align: center;
    }

    .fulu-checkmark {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: block;
        stroke-width: 2;
        stroke: #000;
        stroke-miterlimit: 10;
        box-shadow: inset 0px 0px 0px #000;
        animation: fuluFill .4s ease-in-out .4s forwards, fuluScale .3s ease-in-out .9s both;
    }

    .fulu-checkmark__circle {
        stroke-dasharray: 166;
        stroke-dashoffset: 166;
        stroke-width: 2;
        stroke-miterlimit: 10;
        stroke: #000;
        fill: none;
        animation: fuluStroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
    }

    .fulu-checkmark__check {
        transform-origin: 50% 50%;
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: fuluStroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
    }

    @keyframes fuluStroke { 100% { stroke-dashoffset: 0; } }
    @keyframes fuluScale { 0%, 100% { transform: none; } 50% { transform: scale3d(1.1, 1.1, 1); } }
    @keyframes fuluFill { 100% { box-shadow: inset 0px 0px 0px 30px transparent; } }
    @keyframes fuluFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    @media screen and (max-width: 700px) {
        .fulu-page-content {
            margin-top: 0svh !important;
        }
    }

    @media screen and (max-width: 600px) {
        .fulu-form-row {
            flex-direction: column;
            gap: 0;
        }
        
        .fulu-apply-title {
            font-size: 2rem;
        }
        
        .fulu-apply {
            width: 90%;
            margin-top: 20svh;
        }

        .fulu-submit-btn {
            width: 100%;
            margin-bottom: 10svh;
        }
    }
</style>