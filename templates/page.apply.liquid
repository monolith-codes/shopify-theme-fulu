{% render 'logo-animation-overlay' %}

<div class="fulu-content-container">
    <div class="fulu-page-apply-container">
        <div class="fulu-apply-spacer"></div>
        <div class="fulu-apply-content">
            <div class="fulu-apply-container">
                <div class="fulu-apply">
                    <h1 class="fulu-apply-title">Apply</h1>
                    <p class="fulu-apply-text">Interested in joining the club? Fill out the form below.</p>

                    {% form 'contact' %}
                        {% if form.posted_successfully? %}
                            <p class="form-success">Thanks for applying! We'll be in touch shortly.</p>
                        {% endif %}

                        {{ form.errors | default_errors }}

                        <div class="fulu-form-row">
                            <div class="fulu-form-group">
                                <label for="ContactFormName">Name</label>
                                <input type="text" id="ContactFormName" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
                            </div>
                            <div class="fulu-form-group">
                                <label for="ContactFormEmail">Email</label>
                                <input type="email" id="ContactFormEmail" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
                            </div>
                        </div>

                        <div class="fulu-form-group">
                            <label for="ContactFormPhone">Phone Number</label>
                            <input type="tel" id="ContactFormPhone" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
                        </div>

                        <div class="fulu-form-group">
                            <label for="ContactFormType">I am a...</label>
                            <select id="ContactFormType" name="contact[type]">
                                <option value="Designer">Designer</option>
                                <option value="Artist">Artist</option>
                                <option value="Collector">Collector</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="fulu-form-group">
                            <label for="ContactFormPortfolio">Portfolio / Website</label>
                            <input type="url" id="ContactFormPortfolio" name="contact[portfolio]" placeholder="https://">
                        </div>

                        <div class="fulu-form-group">
                            <label for="ContactFormMessage">Tell us about yourself</label>
                            <textarea rows="5" id="ContactFormMessage" name="contact[body]">{% if form.body %}{{ form.body }}{% endif %}</textarea>
                        </div>

                        <button type="submit" class="fulu-submit-btn">Submit Application</button>
                    {% endform %}
                </div>
            </div>
            {% section 'footer' %}
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function() {
        const container = document.querySelector('.fulu-content-container');
        if (!container) return;

        const handleScroll = () => {
            let scrollTop = container.scrollTop;
            let maxScroll = container.scrollHeight - container.clientHeight;

            if (maxScroll <= 0) {
                scrollTop = window.scrollY || document.documentElement.scrollTop;
                maxScroll = document.documentElement.scrollHeight - window.innerHeight;
            }

            const scrollPercentage = maxScroll > 0 ? scrollTop / maxScroll : 0;

            if (scrollPercentage >= 0.8) {
                const progress = Math.min((scrollPercentage - 0.8) / 0.2, 1);
                // Interpolate from White (255, 255, 255) to rgb(50, 168, 119)
                const r = Math.round(255 - (205 * progress));
                const g = Math.round(255 - (87 * progress));
                const b = Math.round(255 - (136 * progress));
                const color = `rgb(${r}, ${g}, ${b})`;
                container.style.backgroundColor = color;
                document.body.style.backgroundColor = color;
                document.documentElement.style.backgroundColor = color;
            } else {
                container.style.backgroundColor = 'white';
                document.body.style.backgroundColor = 'white';
                document.documentElement.style.backgroundColor = 'white';
            }
        };

        container.addEventListener('scroll', handleScroll);
        window.addEventListener('scroll', handleScroll);
        window.addEventListener('resize', handleScroll);
        
        handleScroll();
        window.addEventListener('load', handleScroll);
    });
</script>

<style>
    .fulu-content-container {
        height: 100vh;
        width: 100%;
        overflow-y: auto;
        background-color: #fff;
    }
    

    .fulu-page-apply-container {
        display: grid;
        width: 100%;
        height: 100%;
        grid-template-columns: 1fr 6.2fr;
    }

    .fulu-apply-spacer {
        height: 100%;
    }

    .fulu-apply-container {
        display: flex;
        justify-content: center;
        margin-top: 35px;
        width: calc(100% - 13.8%);
        font-family: "Inter";
        margin-bottom: 10svh;
    }

    .fulu-apply {
        width: 65%;
    }

    .fulu-apply-title {
        font-size: 2.5rem;
        margin-bottom: 10px;
        text-align: start;
        font-weight: 600;
    }

    .fulu-apply-text {
        text-align: start;
        margin-bottom: 60px;
        color: #333;
    }

    .fulu-form-row {
        display: flex;
        gap: 20px;
    }

    .fulu-form-row .fulu-form-group {
        flex: 1;
    }

    .fulu-form-group {
        margin-bottom: 25px;
    }

    .fulu-form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .fulu-form-group input,
    .fulu-form-group select,
    .fulu-form-group textarea {
        width: 100%;
        padding: 12px 0;
        border: none;
        border-bottom: 1px solid #000;
        background: transparent;
        font-family: "Inter", sans-serif;
        font-size: 1rem;
        outline: none;
        border-radius: 0;
        transition: border-color 0.3s;
    }

    .fulu-form-group input:focus,
    .fulu-form-group select:focus,
    .fulu-form-group textarea:focus {
        border-bottom-color: #666;
    }

    .fulu-submit-btn {
        width: 32.5%;
        padding: 16px;
        background-color: #000;
        color: #fff;
        border: 1px solid #000;
        font-family: "Inter", sans-serif;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 20px;
        border-radius: 20px;
    }

    .fulu-submit-btn:hover {
        background-color: #fff;
        color: #000;
    }

    .form-success {
        background-color: #f4f4f4;
        padding: 15px;
        margin-bottom: 20px;
        text-align: center;
    }

    @media screen and (max-width: 600px) {
        .fulu-form-row {
            flex-direction: column;
            gap: 0;
        }
        
        .fulu-apply-title {
            font-size: 2rem;
        }
    }
</style>