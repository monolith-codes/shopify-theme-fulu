<div class="fulu-password-page">
  <div class="fulu-password-container">
    <h1 class="fulu-password-title">{{ shop.name }}</h1>
    <p class="fulu-password-message">This store is currently restricted. Please enter the password to access.</p>

    {% form 'storefront_password', class: 'fulu-password-form' %}
      {{ form.errors | default_errors }}
      
      <div class="fulu-password-input-wrapper">
        <input 
          type="password" 
          name="password" 
          id="Password" 
          class="fulu-password-input" 
          placeholder="Enter Password"
          autocomplete="current-password"
        >
        <button type="submit" class="fulu-password-btn">Enter</button>
      </div>
    {% endform %}
  </div>
</div>

<style>
  .fulu-password-page {
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f9f9f9; /* Soft off-white to match theme */
    padding: 20px;
    box-sizing: border-box;
  }

  .fulu-password-container {
    max-width: 420px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .fulu-password-title {
    font-family: "tachyon", sans-serif;
    font-size: 2rem;
    font-weight: normal;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #000;
  }

  .fulu-password-message {
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    color: #444;
    margin: 0;
    line-height: 1.5;
  }

  .fulu-password-form {
    width: 100%;
    margin-top: 1rem;
  }

  .fulu-password-form .errors {
    color: #D32F2F;
    background-color: rgba(211, 47, 47, 0.05);
    padding: 10px;
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    margin-bottom: 15px;
    list-style: none;
    text-align: left;
  }

  .fulu-password-input-wrapper {
    display: flex;
    width: 100%;
    border: 1px solid #e0e0e0;
    background-color: #fff;
    transition: border-color 0.3s ease;
  }

  .fulu-password-input-wrapper:focus-within {
    border-color: #000;
  }

  .fulu-password-input {
    flex-grow: 1;
    border: none;
    padding: 16px;
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    background: transparent;
    outline: none;
    color: #000;
  }

  .fulu-password-btn {
    background-color: #000;
    color: #fff;
    border: none;
    padding: 0 24px;
    font-family: "Inter", sans-serif;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .fulu-password-btn:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 480px) {
    .fulu-password-title {
      font-size: 1.5rem;
    }
    
    .fulu-password-input-wrapper {
      flex-direction: column;
      border: none;
      background: transparent;
      gap: 12px;
    }

    .fulu-password-input {
      border: 1px solid #e0e0e0;
      background-color: #fff;
      width: 100%;
      box-sizing: border-box;
    }
    
    .fulu-password-input:focus {
      border-color: #000;
    }

    .fulu-password-btn {
      width: 100%;
      padding: 16px;
    }
  }
</style>