<style>
    .fulu-home-container {
        height: 100vh;
        width: 100%;
        background-color: white;
        overflow-y: auto;
    }
    .fulu-home-grid {
        display: grid;
        min-height: 100%;
        width: 100%;
        grid-template-columns: 1fr 4.5fr;
    }

    .fulu-home-grid-spacer {
        background-color: orange;
    }

    .fulu-home-grid-container {
        height: 100%;
        min-height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .fulu-home-grid-content {
        margin: 35px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
        grid-auto-rows: 7.8svw;
        align-content: start;
        grid-auto-flow: dense;
        gap: 30px;
    }

    .fulu-home-grid-item {
        cursor: pointer;
        background-color: blue;
        border-radius: 15px;
        overflow: hidden;
        position: relative;
    }

    .fulu-home-grid-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .fulu-home-grid-item::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: grey;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
        z-index: 1;
    }

    .fulu-home-grid-item:hover::after {
        opacity: 0.15;
    }

    .fulu-designer-info {
        position: absolute;
        bottom: 20px;
        left: 20px;
        opacity: 0;
        transition: opacity 0.3s ease;
        color: #fff;
        font-size: 1.5rem;
        font-weight: bold;
        text-align: left;
        width: auto;
        pointer-events: none;
        z-index: 2;
    }

    .fulu-home-grid-item:hover .fulu-designer-info {
        opacity: 1;
    }

    .fulu-home-grid-item.i-1 {
        background-color: pink !important;
        grid-column-start: 1;
        grid-column-end: 3;
        grid-row-start:1;
        grid-row-end: 5;
    }

    .fulu-home-grid-item.i-2 {
        background-color: purple !important;
        grid-column-start: 3;
        grid-column-end: 6;
        grid-row-start:1;
        grid-row-end: 6;
   
    }


   .fulu-home-grid-item.i-3 {
        background-color: pink !important;
        grid-column-start: 1;
        grid-column-end: 3;
        grid-row-start: 5;
        grid-row-end: 9;
    }


    .fulu-home-grid-item.i-4 {
        background-color: purple !important;
        grid-column-start: 3;
        grid-column-end: 6;
        grid-row-start:6;
        grid-row-end: 9;
    }

    .fulu-home-grid-item.i-5 {
        background-color: pink !important;
        grid-column-start: 1;
        grid-column-end: 4;
        grid-row-start: 9;
        grid-row-end: 13;
    }

    .fulu-home-grid-item.i-6 {
        background-color: purple !important;
        grid-column-start: 4;
        grid-column-end: 6;
        grid-row-start: 9;
        grid-row-end: 13;
    }

    .fulu-home-grid-item.i-7 {
        background-color: pink !important;
        grid-column-start: 1;
        grid-column-end: 3;
        grid-row-start: 13;
        grid-row-end: 17;
    }

    .fulu-home-grid-item.i-8 {
        background-color: purple !important;
        grid-column-start: 3;
        grid-column-end: 6;
        grid-row-start: 13;
        grid-row-end: 17;
    }

    .fulu-home-footer-container {
        display: flex;
        height: 15svw;
        width: 100%;
        z-index: 100;
        background-color: red !important;
    }
</style>

