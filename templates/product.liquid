{% comment %}
  Minimalist Reference Layout (Fulu Style)
  - Top full-width gallery with counter
  - Bottom 2-column layout (Info Left, Specs Right)
{% endcomment %}

{% render 'logo-animation-overlay' %}

<div class="fulu-content-container">
  <div class="fulu-page-product-container">
    <div class="fulu-product-spacer"></div>
    <div class="fulu-product-content">
      <div class="fulu-product-container">
        <div class="fulu-product">
          {% assign unique_id = 'product-' | append: product.id %}
          <div class="fulu-container" itemscope itemtype="http://schema.org/Product">
            <div class="fulu-gallery">
              {% for media in product.media %}
                <div class="fulu-gallery-item {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
                  {% case media.media_type %}
                    {% when 'image' %}
                      <img 
                        src="{{ media | image_url: width: 2000 }}" 
                        alt="{{ media.alt | escape }}"
                        loading="eager"
                        width="{{ media.width }}"
                        height="{{ media.height }}"
                      >
                    {% when 'video' %}
                      {{ media | video_tag: controls: true, autoplay: true, loop: true, image_size: '2000x' }}
                  {% endcase %}
                </div>
              {% endfor %}

              {% if product.media.size > 1 %}
                <button class="fulu-nav-btn fulu-prev" aria-label="Previous">
                  <img class="fulu-nav-btn-icon" src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/move-left-white.svg?v=1771802714" alt="Previous" width="50" height="50">
                </button>
                <button class="fulu-nav-btn fulu-next" aria-label="Next">
                  <img class="fulu-nav-btn-icon" src="https://cdn.shopify.com/s/files/1/1043/1584/6995/files/move-right-white.svg?v=1771802714" alt="Next" width="50" height="50">
                </button>
                
                <div class="fulu-gallery-counter">
                  <span id="fulu-current-slide">1</span> / {{ product.media.size }}
                </div>
              {% endif %}
            </div>

            <div class="fulu-details">
              
              <div class="fulu-info-left">
                <h1 class="fulu-title">{{ product.title }}</h1>
                
                <div class="fulu-price">
                  <span id="Price-{{ unique_id }}">{{ product.selected_or_first_available_variant.price | money }}</span>
                </div>

                {% form 'product', product %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

                  {% unless product.has_only_default_variant %}
                    {% for option in product.options_with_values %}
                      <div class="fulu-form-group">
                        <div class="fulu-spec-label">{{ option.name }}</div>
                        <div class="fulu-options">
                          {% for value in option.values %}
                            <button type="button" class="fulu-option-btn {% if option.selected_value == value %}selected{% endif %}" data-value="{{ value | escape }}">
                              {{ value }}
                            </button>
                          {% endfor %}
                        </div>
                      </div>
                    {% endfor %}
                  {% endunless %}

                  <button type="submit" name="add" class="fulu-add-to-cart" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                    {% if product.selected_or_first_available_variant.available %}
                      Add to cart
                    {% else %}
                      Sold Out
                    {% endif %}
                  </button>
                {% endform %}

                <a href="{{ collection.url | default: product.collections.first.url }}" class="fulu-contact-link">
                  <svg width="16" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
                    <path d="M15 5H1M5 1L1 5l4 4"/>
                  </svg>Back to designer
                </a>
              </div>

              <div class="fulu-specs-table">
                
                <div class="fulu-spec-row">
                  <div class="fulu-spec-label">Description</div>
                  <div class="fulu-spec-value">{{ product.description }}</div>
                </div>

                <div class="fulu-spec-row">
                  <div class="fulu-spec-label">Category</div>
                  <div class="fulu-spec-value">{{ product.category }}</div>
                </div>

                {% for field in product.metafields.custom %}
                  <div class="fulu-spec-row">
                    <div class="fulu-spec-label">{{ field.first | replace: '_', ' ' | capitalize }}</div>
                    <div class="fulu-spec-value">{{ field.last }}</div>
                  </div>
                {% endfor %}


                {% if product.metafields.shopify.bag-case-material %}
                  <div class="fulu-spec-row">
                    <div class="fulu-spec-label">Material</div>
                    <div class="fulu-spec-value">
                      {%- for value in product.metafields.shopify.bag-case-material.value -%}
                        {{ value.label }}{% unless forloop.last %}, {% endunless %}
                      {%- endfor -%}
                    </div>
                  </div>
                {% endif %}


                {% if product.metafields.shopify.jewelry-material %}
                  <div class="fulu-spec-row">
                    <div class="fulu-spec-label">Material</div>
                    <div class="fulu-spec-value">
                      {%- for value in product.metafields.shopify.jewelry-material.value -%}
                        {{ value.label }}{% unless forloop.last %}, {% endunless %}
                      {%- endfor -%}
                    </div>
                  </div>
                {% endif %}

                {% if product.metafields.shopify.fabric %}
                  <div class="fulu-spec-row">
                    <div class="fulu-spec-label">Material</div>
                    <div class="fulu-spec-value">
                      {%- for value in product.metafields.shopify.fabric.value -%}
                        {{ value.label }}{% unless forloop.last %}, {% endunless %}
                      {%- endfor -%}
                    </div>
                  </div>
                {% endif %}


                {% if product.metafields.shopify.necklace-design %}
                  <div class="fulu-spec-row">
                    <div class="fulu-spec-label">Design</div>
                    <div class="fulu-spec-value">
                      {%- for value in product.metafields.shopify.necklace-design.value -%}
                        {{ value.label }}{% unless forloop.last %}, {% endunless %}
                      {%- endfor -%}
                    </div>
                  </div>
                {% endif %}
                
              </div>
            </div>
          </div>

          <div class="fulu-related-products">
            <h2 class="fulu-related-title">You may also like</h2>
            <div class="fulu-related-grid">
              {% assign current_collection = collection | default: product.collections.first %}
              {% if current_collection %}
                {% assign counter = 0 %}
                {% for related_product in current_collection.products %}
                  {% unless related_product.id == product.id %}
                    <a href="{{ related_product.url }}" class="fulu-product-item">
                      <div class="fulu-product-image-wrapper">
                        <img src="{{ related_product.featured_image | image_url: width: 800 }}" alt="{{ related_product.title }}" loading="lazy" width="800" height="800">
                      </div>
                      <div class="fulu-product-title">{{ related_product.title }}</div>
                    </a>
                    {% assign counter = counter | plus: 1 %}
                    {% if counter == 3 %}{% break %}{% endif %}
                  {% endunless %}
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>
      </div>
      {% section 'footer' %}
    </div>
  </div>
</div>



<script>
  document.addEventListener('DOMContentLoaded', function() {
    
    // Gallery Slider Logic
    const slides = document.querySelectorAll('.fulu-gallery-item');
    const prevBtn = document.querySelector('.fulu-prev');
    const nextBtn = document.querySelector('.fulu-next');
    const counterDisplay = document.getElementById('fulu-current-slide');
    let currentSlide = 0;

    if (slides.length > 1 && prevBtn && nextBtn) {
      function showSlide(index) {
        slides.forEach(slide => slide.classList.remove('active'));
        slides[index].classList.add('active');
        currentSlide = index;
        if(counterDisplay) counterDisplay.textContent = currentSlide + 1;
      }
      prevBtn.addEventListener('click', () => {
        showSlide((currentSlide - 1 + slides.length) % slides.length);
      });
      nextBtn.addEventListener('click', () => {
        showSlide((currentSlide + 1) % slides.length);
      });
    }

    // Variant Selection Logic (Simplified)
    const product = {{ product | json }};
    const options = document.querySelectorAll('.fulu-option-btn');
    const hiddenInput = document.querySelector('input[name="id"]');
    const priceDisplay = document.querySelector('[id^="Price-"]');
    const addToCartBtn = document.querySelector('.fulu-add-to-cart');

    options.forEach(option => {
      option.addEventListener('click', function() {
        const parent = this.closest('.fulu-options');
        parent.querySelectorAll('.selected').forEach(el => el.classList.remove('selected'));
        this.classList.add('selected');

        const selectedOptions = Array.from(document.querySelectorAll('.fulu-options .selected')).map(el => el.dataset.value);
        
        const matchedVariant = product.variants.find(variant => {
          return variant.options.every((val, index) => val === selectedOptions[index]);
        });

        if (matchedVariant) {
          hiddenInput.value = matchedVariant.id;
          if(priceDisplay) priceDisplay.textContent = formatMoney(matchedVariant.price);
          
          if (matchedVariant.available) {
            addToCartBtn.disabled = false;
            addToCartBtn.textContent = 'Add to cart';
          } else {
            addToCartBtn.disabled = true;
            addToCartBtn.textContent = 'Sold Out';
          }

          const newUrl = new URL(window.location);
          newUrl.searchParams.set('variant', matchedVariant.id);
          window.history.replaceState(null, null, newUrl);
        }
      });
    });

    function formatMoney(cents) {
      if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
        return Shopify.formatMoney(cents);
      }
      return (cents / 100).toLocaleString('en-US', {style: 'currency', currency: 'EUR'});
    }

    const productForm = document.querySelector('form[action*="/cart/add"]');
    if (productForm) {
      productForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const submitBtn = productForm.querySelector('[type="submit"]');

        const formData = new FormData(productForm);
        const action = productForm.getAttribute('action') + '.js';

        fetch(action, {
          method: 'POST',
          body: formData
        })
        .then(() => {
          window.location.reload();
        })
        .catch((e) => {
          console.error(e);
          window.location.reload();
        });
      });
    }
  });
</script>

<style>
  .fulu-container {
    max-width: 1000px;
    margin: 0 auto;
  }

   .fulu-page-product-container {
        display: grid;
        width: 100%;
        height: 100%;
        grid-template-columns: 1fr 6.2fr;
        z-index: 200;
    }

    .fulu-product-spacer {
        height: 100%;
    }

    .fulu-product-container {
        display: flex;
        justify-content: center;
        margin-top: 35px;
        margin-bottom: 0;
        width: calc(100% - 13.8%);
        font-family: "Inter";
    }

    .fulu-product {
        width: 65%;
        position: relative;
        right: 2%;
        z-index: 2;
    }

  /* --- Gallery Section --- */
  .fulu-gallery {
    position: relative;
    width: 100%;
    margin-bottom: 60px;
    background-color: #ebebeb; /* Light grey placeholder background */
    border-radius: 12px;
    aspect-ratio: 1.75 / 1;
  }

  .fulu-gallery-item {
    display: none;
    width: 100%;
    height: 100%;
    border-radius: 12px;
  }

  .fulu-gallery-item.active {
    display: block;
    animation: fadeIn 0.4s ease-in-out;
    border-radius: 12px;
  }

  .fulu-gallery img, .fulu-gallery video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  .fulu-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 20px;
    z-index: 10;
    transition: opacity 0.2s;
    opacity: 0.5;
  }

  .fulu-nav-btn:hover {
    opacity: 1;
  }

  .fulu-prev { left: 20px; }
  .fulu-next { right: 20px; }

  .fulu-nav-btn svg {
    width: 30px;
    height: 30px;
    stroke: #000;
    stroke-width: 1.5;
  }

  .fulu-gallery-counter {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    color: white;
  }

  @keyframes fadeIn {
    from { opacity: 0.8; }
    to { opacity: 1; }
  }

  /* --- Bottom Details Layout --- */
  .fulu-details {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .fulu-details {
      gap: 60px;
    }
  }

  @media (min-width: 1200px) {
    .fulu-details {
      gap: 100px;
    }
    .fulu-info-left {
      flex: 0 0 300px;
    }
  }

  /* Left Column: Core Info */
  .fulu-info-left {
    position: relative;
    flex: 1 1 300px;
  }

  @media (min-width: 900px) {
    .fulu-info-left {
      position: sticky;
      top: 40px;
    }
  }

  .fulu-title {
    font-size: 2.5rem;
    font-weight: 700 !important;
    margin: 0 0 10px 0;
    line-height: 1.2;
  }

  .fulu-price {
    font-size: 1.1rem;
    margin-bottom: 30px;
    color: #333;
  }

  .fulu-add-to-cart {
    width: 100%;
    background: #000;
    color: #fff;
    border: 1px solid #000;
    padding: 8px;
    font-size: 1.3rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    margin-bottom: 20px;
    border-radius: 8px;
  }

  .fulu-add-to-cart:hover {
    background-color: #fff;
    color: #000;
  }

  .fulu-add-to-cart:disabled {
    background: #e0e0e0;
    color: #999;
    border-color: #e0e0e0;
    cursor: not-allowed;
  }

  .fulu-contact-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.9rem;
    color: #000;
    text-decoration: none;
    position: relative;
  }

  .fulu-contact-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 2px;
    background-color: black;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .fulu-contact-link:hover::after {
    transform: scaleX(1);
  }

  /* Right Column: Specifications Table */
  .fulu-specs-table {
    display: flex;
    flex-direction: column;
    flex: 999 1 300px;
    min-width: 0;
  }

  .fulu-spec-row {
    display: grid;
    grid-template-columns: 1fr;
    padding: 20px 0;
    border-bottom: 2px solid #707070;
    gap: 10px;
  }
  
  /* The description row has no border top in the reference, but subsequent items have borders */
  .fulu-spec-row:first-child {
    padding-top: 0;
  }

  @media (min-width: 600px) {
    .fulu-spec-row {
      grid-template-columns: 200px 1fr;
      gap: 30px;
      padding: 24px 0;
    }
  }

  .fulu-spec-label {
    font-size: .9rem;
    font-weight: 600;
    line-height: 1.5;
    color: #000;
  }

  .fulu-spec-value {
    font-size: .9rem;
    font-weight: 400;
    color: #313131;
    line-height: 1.5;
    margin: 0;
  }

  
  .fulu-spec-value p{
    margin: 0;
  }

  /* --- Related Products --- */
  .fulu-related-products {
    margin-top: 100px;
    width: 100%;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 10svh;
  }

  .fulu-related-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 30px;
  }

  .fulu-related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
  }

  .fulu-product-item {
    text-decoration: none;
    color: black;
    display: block;
    position: relative;
    border-radius: 15px;
    overflow: hidden;
  }

  .fulu-product-item::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: grey;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .fulu-product-item:hover::after {
    opacity: 0.15;
  }

  .fulu-product-image-wrapper {
    width: 100%;
    aspect-ratio: 1/1;
    background-color: #f4f4f4;
  }

  .fulu-product-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .fulu-product-item:hover .fulu-product-title {
    opacity: 1;
  }

  /* Variants (Kept for compatibility if your products have them) */
  .fulu-form-group { margin-bottom: 20px; }
  .fulu-options { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px;}
  .fulu-option-btn { border: 1px solid #ccc; background: #fff; padding: 8px 16px; cursor: pointer; }
  .fulu-option-btn.selected { border-color: #000; background: #000; color: #fff; }


  #shopify-pc__banner__btn-accept {
    background-color: black ;
    color: white ;
    transition: all ease 0.35s;
  }

  #shopify-pc__banner__btn-accept:hover {
    background-color: white !important;
    color: black !important;
    border: 1px solid black !important;
  }

  /* Reuse product title style from collection but scoped if needed */
  .fulu-product-title {
      position: absolute;
      bottom: 20px;
      left: 20px;
      opacity: 0;
      transition: opacity 0.3s ease;
      color: #fff;
      font-size: 1.2rem;
      font-weight: bold;
      text-align: left;
      width: auto;
      z-index: 4;
  }

  @media (orientation: portrait) {
    .fulu-details {
      flex-direction: column;
      align-items: stretch;
    }
    .fulu-info-left {
      position: static !important;
      flex: auto !important;
    }
    .fulu-specs-table {
      flex: auto !important;
    }
  }

  @media screen and (max-width: 768px) {
    .fulu-page-product-container {
      grid-template-columns: 1fr;
    }
    .fulu-product-spacer {
      display: none;
    }
    .fulu-product-container {
      width: 100%;
      margin-top: 20px;
    }
    .fulu-product {
      width: 90%;
      right: 0;
      margin: 0 auto;
    }
    .fulu-gallery {
      margin-top: 40svh;
    }
    .fulu-related-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .fulu-product-title {
      opacity: 1;
    }
  }

    @media screen and (max-width: 600px) {
      .fulu-gallery {
        margin-top: 25svh;
      }
    }

    @media screen and (max-width: 350px) {
      .fulu-gallery {
        margin-top: 20svh;
      }
    }
</style>